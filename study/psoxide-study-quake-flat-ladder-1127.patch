+/// STUDY (quake-render lane, 2026-11-27, never merged): palette light ladder.
+/// With `world-flat-light-ladder` every world packet is written flat-textured
+/// (raw texture, GP0 25h/2Dh) and its CLUT word is picked from this table by
+/// the packet's mean corner intensity (green channel, 0..255). The game fills
+/// it with the CLUT words of pre-darkened copies of its palette.
+#[cfg(feature = "world-flat-light-ladder")]
+pub static mut WORLD_LIGHT_LADDER: [u16; 256] = [0; 256];
+
+#[cfg(feature = "world-flat-light-ladder")]
+#[inline(always)]
+fn ladder_clut_high(intensity: u32) -> u32 {
+    // SAFETY: a plain table read; the game writes it only at load.
+    (unsafe { *core::ptr::addr_of!(WORLD_LIGHT_LADDER).cast::<u16>().add(intensity as usize & 0xff) }
+        as u32)
+        << 16
+}
+
+/// Packet words (tag included) of the world path's triangle and quad.
+#[cfg(not(feature = "world-flat-light-ladder"))]
+const TRI_PACKET_WORDS: usize = size_of::<ClassicTriTexturedGouraud>() / size_of::<u32>();
+#[cfg(not(feature = "world-flat-light-ladder"))]
+const QUAD_PACKET_WORDS: usize = size_of::<ClassicQuadTexturedGouraud>() / size_of::<u32>();
+#[cfg(feature = "world-flat-light-ladder")]
+const TRI_PACKET_WORDS: usize = 8;
+#[cfg(feature = "world-flat-light-ladder")]
+const QUAD_PACKET_WORDS: usize = 10;
+
+/// Words per vertex in a world packet body.
+#[cfg(feature = "world-flat-light-ladder")]
+const VERTEX_STRIDE: usize = 2;
+#[cfg(not(feature = "world-flat-light-ladder"))]
+const VERTEX_STRIDE: usize = 3;
+
 /// Extra vertex slots the caller reserves after a world batch for the
 /// points a split face generates.
